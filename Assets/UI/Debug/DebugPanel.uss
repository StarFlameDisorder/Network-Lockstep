.debug-panel {
    background-color: rgba(20, 20, 30, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(100, 100, 120, 0.3);
    padding: 8px;
    margin: 4px;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 46%;
    overflow: hidden;
}

.panel-left {
    left: 1%;
}

.panel-right {
    right: 1%;
    left: auto;
}

.panel-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(200, 200, 220);
    margin-bottom: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 100, 120, 0.3);
}

.section-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(160, 180, 200);
    margin-top: 6px;
    margin-bottom: 2px;
}

.status-ok {
    color: rgb(80, 220, 80);
}

.status-off {
    color: rgb(140, 140, 140);
}

.status-err {
    color: rgb(255, 80, 80);
}

Button {
    font-size: 11px;
    min-height: 22px;
    margin: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 3px;
    border-width: 1px;
}

Button:hover {
    border-color: rgba(160, 180, 220, 0.6);
}

Button:focus {
    border-color: rgb(100, 160, 255);
    border-width: 2px;
}

.btn-primary {
    background-color: rgba(50, 150, 50, 0.6);
    border-color: rgba(80, 200, 80, 0.5);
    color: white;
}

.btn-primary:hover {
    background-color: rgba(50, 150, 50, 0.8);
}

.btn-danger {
    background-color: rgba(180, 50, 50, 0.6);
    border-color: rgba(220, 80, 80, 0.5);
    color: white;
}

.btn-danger:hover {
    background-color: rgba(180, 50, 50, 0.8);
}

.btn-normal {
    background-color: rgba(60, 60, 80, 0.6);
    color: rgb(200, 200, 220);
}

.btn-normal:hover {
    background-color: rgba(80, 80, 110, 0.8);
}

TextField,
IntegerField {
    font-size: 11px;
    min-height: 20px;
    margin: 2px;
    color: rgb(0, 0, 0);
    /*aspect-ratio: auto;*/
}

TextField:focus,
IntegerField:focus {
    background-color: rgba(40, 40, 60, 0.9);
    border-width: 1px;
    border-color: rgb(100, 160, 255);
    color: white;
}

Label {
    font-size: 15px;
    color: rgb(200, 200, 220);
}

.log-area {
    background-color: rgba(10, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(80, 80, 100, 0.3);
    border-radius: 4px;
    min-height: 80px;
    max-height: 120px;
    margin-top: 4px;
    padding: 2px;
}

.log-area Label {
    font-size: 10px;
    color: rgb(180, 190, 200);
    -unity-text-align: middle-left;
}

Toggle {
    min-height: 20px;
    font-size: 15px;
    color: rgb(150, 150, 150);
    margin-top: 2px;
}

.button-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
    margin-bottom: 2px;
}

.panel-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.btn-small {
    font-size: 10px;
    min-height: 18px;
    min-width: 24px;
    margin-left: 4px;
    padding: 0 4px;
    background-color: rgba(60, 60, 80, 0.6);
    color: rgb(180, 180, 200);
}

.label-mono {
    font-size: 18px;
    color: rgb(140, 220, 140);
    -unity-font-style: bold;
}

.input-row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.input-row Label {
    min-width: 36px;
    font-size: 18px;
    color: rgb(160, 170, 190);
}

.input-row TextField {
    flex-grow: 1;
    font-size: 18px;
    min-height: 22px;
    color: rgb(0, 0, 0);
}
