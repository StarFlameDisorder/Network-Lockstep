<!--
服务端调试面板 UXML
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/Debug/DebugPanel.uss" />
    <ui:VisualElement class="debug-panel panel-right" name="panel-root" focusable="true" picking-mode="Position">

        <ui:VisualElement class="panel-header-row">
            <ui:Label text="服务端" class="panel-title" style="flex-grow:1" />
            <ui:Button name="btn-toggle-panel" text="▼" class="btn-small" />
        </ui:VisualElement>

        <ui:VisualElement name="panel-content">

            <!-- ═══ 服务器 ═══ -->
            <ui:Label text="服务器" class="section-title" />

            <ui:VisualElement class="input-row">
                <ui:Label text="TCP:" />
                <ui:TextField name="field-tcpport" value="1975" style="width:56" />
                <ui:Label text="UDP:" />
                <ui:TextField name="field-udpport" value="1975" style="width:56" />
            </ui:VisualElement>

            <ui:VisualElement class="input-row">
                <ui:Label text="帧率:" />
                <ui:TextField name="field-framerate" value="30" style="width:40" />
                <ui:Button name="btn-start" text="启动" class="btn-primary" />
                <ui:Button name="btn-stop" text="停止" class="btn-danger" />
                <ui:Label name="label-server-status" text="○" class="status-off" />
            </ui:VisualElement>

            <ui:Label name="label-port-info" text="TCP:-  UDP:-  帧率:-FPS" />

            <!-- ═══ 客户端 / 房间 ═══ -->
            <ui:VisualElement class="split-row">
                <ui:VisualElement class="split-left">
                    <ui:Label text="客户端列表" class="section-title" />
                    <ui:ScrollView name="area-clients" class="log-area" />
                </ui:VisualElement>
                <ui:VisualElement class="split-right">
                    <ui:Label text="房间玩家" class="section-title" />
                    <ui:ScrollView name="area-players" class="log-area" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ═══ 游戏状态 ═══ -->
            <ui:Label text="游戏状态" class="section-title" />

            <ui:Label name="label-frame-info" text="帧号: -  在线: -/-" class="label-mono" />
            <ui:Label name="label-game-state" text="-- 未开始 --" class="log-area" style="padding: 4px; min-height: 30px; -unity-text-align: upper-left;" />

            <!-- ═══ 发送消息(广播) ═══ -->
            <ui:Label text="发送消息(广播)" class="section-title" />
            <ui:VisualElement class="input-row">
                <ui:TextField name="field-message" value="" style="flex-grow:1" />
                <ui:Button name="btn-sendtcp" text="TCP" class="btn-normal" />
                <ui:Button name="btn-sendudp" text="UDP" class="btn-normal" />
            </ui:VisualElement>

            <!-- ═══ 消息 ═══ -->
            <ui:Label text="消息" class="section-title" />
            <ui:ScrollView name="area-messages" class="log-area" />

            <ui:Toggle name="toggle-verbose" text="详细日志" value="false" />
            <ui:ScrollView name="area-verbose" class="log-area" />
            <ui:Button name="btn-clear-log" text="清空日志" class="btn-normal" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
